# TEMPORARY env file for TEMP_agent_test.py - delete when finished.
#
# Paste your key after the '=' with no quotes and no spaces, e.g.
#   ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
#
# NOTE: if ANTHROPIC_API_KEY is already set in your environment, that one wins
# and this file is ignored. Use `set ANTHROPIC_API_KEY=` to clear it first.
#
# DO NOT COMMIT THIS FILE. It is listed in .gitignore.

