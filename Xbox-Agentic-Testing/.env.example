# .env.example - copy to .env and fill in. .env is git-ignored; never commit keys.
# Every variable is optional except the API key for the provider you use.
# Defaults shown are the ones in config/settings.yaml.

# --- LLM provider ---------------------------------------------------------
AGENTIC_LLM_PROVIDER=anthropic          # anthropic | openai | google | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=32000
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash
# OLLAMA_MODEL=llama3.2

# --- runtime --------------------------------------------------------------
DRY_RUN=false
EXECUTION_MODE=scenario
MAX_STEPS=250
MAX_REPLANS=1
RUN_TIMEOUT=3600
MENU_MAX_CYCLES=25
OCR_ENABLED=true
LEARNING_ENABLED=true
REPORT_MAX_PAIRS=2

# --- logging --------------------------------------------------------------
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./artifacts/agentic.log

# --- paths (relative to Xbox-Agentic-Testing/) ----------------------------
ARTIFACTS_DIR=./artifacts
REPORTS_DIR=./artifacts/reports
SCENARIOS_DIR=./scenarios
PROMPTS_DIR=./config/prompts
AUTOMATION_ROOT=../Xbox-Automation-Python
CONTROLS_CONFIG=../Xbox-Automation-Python/config/controls.yaml
